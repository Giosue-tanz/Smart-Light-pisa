    <tag k="cycle_network" v="IT:TOS"/>
    <tag k="description:it" v="Percorso ciclabile in corso di realizzazione che segue la discesa del fiume Arno dalla sua sorgente fino alla foce a Marina di Pisa, sulla costa del Tirreno. Nel mezzo, 220 chilometri di paesaggi toscani, fra colline, campagne e città d’arte."/>
    <tag k="distance" v="360"/>
    <tag k="fixme" v="split to superroute?"/>
    <tag k="from" v="monte Falterona, nel Parco nazionale delle Foreste Casentinesi"/>
    <tag k="name" v="Ciclovia dell'Arno"/>
    <tag k="network" v="rcn"/>
    <tag k="note:it" v="Il percorso dal Monte Falterona, alla foce a Marina di Pisa, e del Sentiero della Bonifica, lungo il Canale Maestro della Chiana è di circa 360 km, di cui il 68% è realizzato, il 22% è in corso di realizzazione e il 10% è in corso di progettazione (2024)."/>
    <tag k="roundtrip" v="no"/>
    <tag k="route" v="bicycle"/>
    <tag k="to" v="Marina di Pisa"/>
    <tag k="type" v="route"/>
    <tag k="website" v="https://www.regione.toscana.it/-/sistema-integrato-della-ciclovia-dell-arno-sentiero-della-bonifica"/>
    <tag k="wikidata" v="Q16541263"/>
    <tag k="wikipedia" v="it:Ciclovia dell'Arno"/>
  </relation>
